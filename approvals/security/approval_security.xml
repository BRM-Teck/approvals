<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_human_resources_approvals" model="ir.module.category">
        <field name="name">Approvals</field>
        <field name="description">Helps you manage approvals.</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_approval_user" model="res.groups.privilege">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_human_resources_approvals"/>
    </record>

    <record id="privilege_approval_manager" model="res.groups.privilege">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_human_resources_approvals"/>
    </record>

    <record id="privilege_approval_manager_all" model="res.groups.privilege">
        <field name="name">Manager: Approve all requests</field>
        <field name="category_id" ref="module_category_human_resources_approvals"/>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_approval_user"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_approval_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_manager_all'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    
    <record id="group_approval_manager_all" model="res.groups">
        <field name="name">Manager: Approve all requests</field>
        <field name="privilege_id" ref="privilege_approval_manager_all"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <!-- Record Rules for Category -->
    <record id="approval_category_company_rule" model="ir.rule">
        <field name="name">Approval Category multi-company</field>
        <field name="model_id" ref="model_approval_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Record Rules for Request -->
    <record id="approval_request_request_approver_rule" model="ir.rule">
        <field name="name">Approval Request: request approver rule</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('approvals.group_approval_user'))]"/>
        <field name="domain_force">['|', ('request_owner_id', '=', user.id), ('approver_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="approval_request_unlink_request_owner_rule" model="ir.rule">
        <field name="name">Approval Request: unlink request owner rule</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('approvals.group_approval_user'))]"/>
        <field name="domain_force">[('request_owner_id.id', '=', user.id), ('request_status', 'in', ('new', 'cancel'))]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="approval_request_manager_rule" model="ir.rule">
        <field name="name">Approval Request: manager</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('approvals.group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="approval_request_multi_company_rule" model="ir.rule">
        <field name="name">approval_request multi-company</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
