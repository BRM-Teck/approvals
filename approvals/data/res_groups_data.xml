<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- 1. Niveau Utilisateur de base -->
        <record id="approvals.group_approval_user" model="res.groups">
            <field name="name">Approbateur (Désigné)</field>
            <field name="comment">Permet à l'utilisateur de créer des demandes et d'approuver uniquement celles où il est explicitement désigné dans le circuit de validation.</field>
        </record>
        
        <!-- 2. Niveau Super-Approbateur -->
        <record id="approvals.group_approval_manager_all" model="res.groups">
            <field name="name">Super-Approbateur (Toutes les demandes)</field>
            <field name="comment">Permet d'approuver, refuser ou annuler N'IMPORTE QUELLE demande d'approbation dans le système, même sans être dans le circuit.</field>
            <!-- Doit impliquer l'utilisateur de base pour créer la hiérarchie linéaire -->
            <field name="implied_ids" eval="[(4, ref('approvals.group_approval_user'))]"/>
        </record>

        <!-- 3. Niveau Administrateur -->
        <record id="approvals.group_approval_manager" model="res.groups">
            <field name="name">Administrateur (Configuration)</field>
            <field name="comment">Permet de configurer les catégories de validation et inclut les droits de Super-Approbateur.</field>
            <!-- Remplace l'implication vers "user" par une implication vers "manager_all" -->
            <field name="implied_ids" eval="[(6, 0, [ref('approvals.group_approval_manager_all')])]"/>
        </record>
    </data>
</odoo>
