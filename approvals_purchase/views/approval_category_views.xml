<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_category_view_form_inherit_purchase" model="ir.ui.view">
        <field name="name">approval.category.view.form.inherit.purchase</field>
        <field name="model">approval.category</field>
        <field name="inherit_id" ref="approvals.approval_category_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_type']" position="replace">
                <field name="approval_type" required="1"/>
            </xpath>
            <xpath expr="//field[@name='has_product']" position="attributes">
                <attribute name="readonly">approval_type == 'purchase'</attribute>
            </xpath>
            <xpath expr="//field[@name='has_quantity']" position="attributes">
                <attribute name="readonly">approval_type == 'purchase'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
