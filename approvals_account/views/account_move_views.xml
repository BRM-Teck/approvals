<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_approval" model="ir.ui.view">
        <field name="name">account.move.form.inherit.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_approval" type="object" string="Request Approval" 
                        invisible="state != 'draft' or approval_request_id"/>
                <field name="approval_request_status" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(approvals.approval_request_action)d" type="action" class="oe_stat_button" icon="fa-check-square-o" invisible="not approval_request_id" context="{'default_account_move_id': id, 'search_default_account_move_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Approval</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="approval_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
