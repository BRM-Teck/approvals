<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_request_view_form_inherit_account" model="ir.ui.view">
        <field name="name">approval.request.view.form.inherit.account</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not account_move_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Invoice</span>
                    </div>
                </button>
                <button name="action_open_payment" type="object" class="oe_stat_button" icon="fa-money" invisible="not account_payment_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="account_move_id" invisible="1"/>
                <field name="account_payment_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
