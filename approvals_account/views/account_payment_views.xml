<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_approval" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.approval</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_approval_user" invisible="1"/>
                <button name="action_request_approval" type="object" string="Request Approval" class="oe_highlight"
                        invisible="state != 'draft' or approval_request_id != False or not is_approval_user"/>
                <button name="action_request_approval" type="object" string="Request Approval" 
                        invisible="state != 'draft' or approval_request_id != False or is_approval_user"/>
                <field name="approval_request_status" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="invisible">state != 'draft' or (not approval_request_id and is_approval_user) or (approval_request_id and approval_request_status != 'approved')</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(approvals.approval_request_action)d" type="action" class="oe_stat_button" icon="fa-check-square-o" invisible="not approval_request_id" context="{'default_account_payment_id': id, 'search_default_account_payment_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Approval</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="approval_request_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
