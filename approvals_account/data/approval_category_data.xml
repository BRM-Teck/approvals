<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="approval_category_data_invoice" model="approval.category">
            <field name="name">Approbation de Facture</field>
            <field name="approval_type">invoice</field>
            <field name="automated_sequence">True</field>
            <field name="sequence_code">INV</field>
            <field name="has_amount">required</field>
            <field name="has_partner">required</field>
            <field name="active" eval="True"/>
        </record>

        <record id="approval_category_data_payment" model="approval.category">
            <field name="name">Approbation de Paiement</field>
            <field name="approval_type">payment</field>
            <field name="automated_sequence">True</field>
            <field name="sequence_code">PAY</field>
            <field name="has_amount">required</field>
            <field name="has_partner">required</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
